{
  "indexVersion": 1,
  "name": "New API Official Plugins",
  "plugins": [
    {
      "key": "alibaba",
      "name": "Alibaba Bailian · Qwen extension",
      "icon": "Bailian.Color",
      "description": {
        "en": "Private Qwen Image 3.0 extension of the QuantumNous Alibaba image and video plugin",
        "zh": "基于QuantumNous官方插件的私有扩展：万相图片视频与千问图片3.0"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/ali/compatible-mode/v1/images/generations",
          "type": "submit",
          "decode": "createQwenCompatible",
          "render": "qwenImageCreated",
          "models": [
            "qwen-image-3.0",
            "qwen-image-3.0-pro"
          ]
        },
        {
          "method": "POST",
          "path": "/ali/api/v1/services/aigc/multimodal-generation/generation",
          "type": "submit",
          "decode": "createImageTask",
          "render": "imageCreated",
          "models": [
            "qwen-image-3.0",
            "qwen-image-3.0-pro",
            "wan2.7-image-pro",
            "wan2.7-image",
            "wan2.6-image",
            "wan2.6-t2i"
          ]
        },
        {
          "method": "POST",
          "path": "/ali/api/v1/services/aigc/image-generation/generation",
          "type": "submit",
          "decode": "createImageTask",
          "render": "taskCreated",
          "models": [
            "qwen-image-3.0",
            "qwen-image-3.0-pro",
            "wan2.7-image-pro",
            "wan2.7-image",
            "wan2.6-image",
            "wan2.6-t2i"
          ]
        },
        {
          "method": "POST",
          "path": "/ali/api/v1/services/aigc/text2image/image-synthesis",
          "type": "submit",
          "decode": "createImageTask",
          "render": "taskCreated",
          "models": [
            "wan2.5-t2i-preview",
            "wan2.2-t2i-flash",
            "wan2.2-t2i-plus",
            "wanx2.1-t2i-turbo",
            "wanx2.1-t2i-plus",
            "wanx2.0-t2i-turbo"
          ]
        },
        {
          "method": "POST",
          "path": "/ali/api/v1/services/aigc/video-generation/video-synthesis",
          "type": "submit",
          "decode": "createVideoTask",
          "render": "taskCreated"
        },
        {
          "method": "POST",
          "path": "/ali/api/v1/services/aigc/image2video/video-synthesis",
          "type": "submit",
          "decode": "createVideoTask",
          "render": "taskCreated"
        },
        {
          "method": "GET",
          "path": "/ali/api/v1/tasks/:task_id",
          "type": "query",
          "render": "taskStatus",
          "taskIdParam": "task_id"
        }
      ],
      "protocols": [
        {
          "name": "openai_responses",
          "supports": [
            "stream",
            "sync",
            "background"
          ]
        },
        {
          "name": "openai_video",
          "models": [
            "wan3.0-video",
            "wan3.0-video-prime",
            "wan2.7-t2v",
            "wan2.7-i2v",
            "wan2.6-t2v",
            "wan2.6-t2v-us",
            "wan2.6-i2v",
            "wan2.6-i2v-flash",
            "wan2.6-i2v-us",
